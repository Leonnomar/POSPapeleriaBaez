<UserControl x:Class="PapeleriaBaez.Views.CanjesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PapeleriaBaez.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="🎒 Canjes Escolares"
                   FontSize="28"
                   FontWeight="Bold"
                   Margin="0,0,0,15"/>

        <TabControl Grid.Row="1">

            <!-- ALTAS -->
            <TabItem Header="📥Altas">
                <Grid Margin="15">

                    <TabControl>

                        <TabItem Header="🎒 Útiles">
                            <Grid Margin="15">

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Entrada de paquetes"
                                        FontSize="20"
                                        FontWeight="Bold"/>

                                <StackPanel Grid.Row="1"
                                        Orientation="Horizontal"
                                        Margin="0,15">

                                    <TextBlock Text="Paquete:"
                                            VerticalAlignment="Center"/>

                                    <ComboBox x:Name="cmbPaquete"
                                            Width="150"
                                            Margin="10,0"/>

                                    <TextBlock Text="Cantidad recibida:"
                                            VerticalAlignment="Center"
                                            Margin="20,0,0,0"/>

                                    <TextBox x:Name="txtCantidadPaquete"
                                            Width="100"
                                            Height="30"
                                            Margin="10,0"/>

                                    <Button Content="Registrar entrada"
                                        Width="140"
                                        Margin="15,0"
                                        Click="BtnEntradaPaquete_Click"/>

                                </StackPanel>

                                <DataGrid x:Name="dgPaquetes"
                                        Grid.Row="2"
                                        AutoGenerateColumns="False"
                                        CanUserAddRows="False">

                                    <DataGrid.Columns>

                                        <DataGridTextColumn Header="Paquete"
                                                        Binding="{Binding NumeroPaquete}"
                                                        Width="*"/>

                                        <DataGridTextColumn Header="Existencia"
                                                        Binding="{Binding Existencia}"
                                                        Width="*"/>

                                        <DataGridTextColumn Header="Entregados"
                                                        Binding="{Binding Entregados}"
                                                        Width="*"/>

                                    </DataGrid.Columns>

                                </DataGrid>

                            </Grid>
                        </TabItem>

                        <TabItem Header="👕 Uniformes">
                            <Grid Margin="15">

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Entrada de Uniformes"
                                        FontSize="20"
                                        FontWeight="Bold"/>

                                <WrapPanel Grid.Row="1"
                                        Margin="0,15">

                                    <TextBlock Text="Tipo:"
                                            VerticalAlignment="Center"/>

                                    <ComboBox x:Name="cmbTipoUniforme"
                                            Width="175"
                                            Margin="10,0"
                                              IsEditable="False"
                                              SelectionChanged="cmbTipoUniforme_SelectionChanged"/>

                                    <TextBlock Text="Color:"
                                            VerticalAlignment="Center"/>

                                    <ComboBox x:Name="cmbColorUniforme"
                                            Width="120"
                                            Margin="10,0"
                                              IsEditable="False"/>

                                    <TextBlock Text="Talla:"
                                            VerticalAlignment="Center"/>

                                    <ComboBox x:Name="cmbTallaUniforme"
                                            Width="100"
                                            Margin="10,0"
                                              IsEditable="False"/>

                                    <TextBlock Text="Cantidad:"
                                            VerticalAlignment="Center"/>

                                    <TextBox x:Name="txtCantidadUniforme"
                                            Width="80"
                                            Height="30"
                                            Margin="10,0"/>

                                    <Button Content="Registrar Entrada"
                                        Width="140"
                                        Margin="10,0"
                                        Click="BtnEntradaUniforme_Click"/>

                                </WrapPanel>

                                <DataGrid x:Name="dgUniformes"
                                        Grid.Row="2"
                                        AutoGenerateColumns="False"
                                        CanUserAddRows="False">

                                    <DataGrid.Columns>

                                        <DataGridTextColumn Header="Tipo"
                                                        Binding="{Binding Tipo}"
                                                        Width="*"/>

                                        <DataGridTextColumn Header="Color"
                                                        Binding="{Binding Color}"
                                                        Width="*"/>

                                        <DataGridTextColumn Header="Talla"
                                                        Binding="{Binding Talla}"
                                                        Width="*"/>

                                        <DataGridTextColumn Header="Existencia"
                                                        Binding="{Binding Existencia}"
                                                        Width="*"/>

                                        <DataGridTextColumn Header="Entregados"
                                                        Binding="{Binding Entregados}"
                                                        Width="*"/>

                                    </DataGrid.Columns>

                                </DataGrid>

                            </Grid>
                        </TabItem>

                        <TabItem Header="👟 Tenis">

                            <Grid Margin="15">

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Entrada de Tenis"
                                           FontSize="20"
                                           FontWeight="Bold"/>

                                <StackPanel Grid.Row="1"
                                            Orientation="Horizontal"
                                            Margin="0,0,0,15">

                                    <TextBlock Text="Talla:"
                                               VerticalAlignment="Center"/>

                                    <ComboBox Name="cmbTallaTenis"
                                              Width="120"
                                              Margin="10,0"/>

                                    <TextBlock Text="Cantidad:"
                                               VerticalAlignment="Center"
                                               Margin="20,0,0,0"/>

                                    <TextBox x:Name="txtCantidadTenis"
                                             Width="100"
                                             Height="30"
                                             Margin="10,0"/>

                                    <Button Content="Registrar entrada"
                                            Width="140"
                                            Click="BtnEntradaTenis_Click"/>
                                    
                                </StackPanel>

                                <DataGrid x:Name="dgTenis"
                                          Grid.Row="2"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          IsReadOnly="True">

                                    <DataGrid.Columns>

                                        <DataGridTextColumn Header="Talla"
                                                            Binding="{Binding Talla}"
                                                            Width="*"/>

                                        <DataGridTextColumn Header="Existencia"
                                                            Binding="{Binding Existencia}"
                                                            Width="120"/>

                                        <DataGridTextColumn Header="Entregados"
                                                            Binding="{Binding Entregados}"
                                                            Width="120"/>
                                    </DataGrid.Columns>
                                    
                                </DataGrid>
                                
                            </Grid>
                            
                        </TabItem>

                    </TabControl>

                </Grid>
            </TabItem>

            <!-- REGISTRAR -->
            <TabItem Header="✅ Registrar Canje">
                <Grid Margin="15">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <GroupBox Grid.Column="0"
                              Header="🎒 Canje de útiles"
                              Margin="0,0,10,0">

                        <StackPanel Margin="15">

                            <TextBlock Text="Paquete"/>

                            <ComboBox x:Name="cmbEntregaPaquete"
                                      Height="30"
                                      Margin="0,5,0,15"
                                      SelectionChanged="cmbEntregaPaquete_SelectionChanged"/>

                            <TextBlock Text="Cantidad"/>

                            <TextBox x:Name="txtEntregaPaquete"
                                     Height="30"
                                     Text="1"
                                     Margin="0,5,0,15"
                                     TextChanged="txtEntregaPaquete_TextChanged"
                                     PreviewTextInput="SoloEnteros_PreviewTextInput"/>

                            <TextBlock x:Name="lblExistenciaPaquete"
                                       Text="Disponibles: 0"
                                       FontWeight="Bold"
                                       Margin="0,0,0,15"/>

                            <Button x:Name="btnRegistrarEntregaPaquete"
                                    Content="Registrar entrega de útiles"
                                    Height="40"
                                    IsEnabled="False"
                                    Click="BtnRegistrarEntregaPaquete_Click"/>

                        </StackPanel>

                    </GroupBox>

                    <GroupBox Grid.Column="1"
                            Header="👕 Canje de uniformes"
                            Margin="10,0">

                        <StackPanel Margin="15">

                            <TextBlock Text="Cantidad de conjuntos"
                                    FontWeight="Bold"/>

                            <StackPanel Orientation="Horizontal"
                                    Margin="0,10,0,15">

                                <RadioButton x:Name="rbUnConjunto"
                                            Content="1 conjunto"
                                            IsChecked="True"
                                            Margin="0,0,20,0"/>

                                <RadioButton x:Name="rbDosConjuntos"
                                            Content="2 conjuntos"/>

                            </StackPanel>

                            <Button Content="Capturar conjuntos"
                                    Height="40"
                                    Click="BtnCapturarConjuntos_Click"/>

                        </StackPanel>

                    </GroupBox>

                    <GroupBox Grid.Column="2"
                              Header="👟 Canje de tenis"
                              Margin="10,0,0,0">

                        <StackPanel Margin="15">

                            <TextBlock Text="Talla"
                                       FontWeight="Bold"/>

                            <ComboBox x:Name="cmbEntregaTenis"
                                      Height="30"
                                      Margin="0,5,0,15"
                                      SelectionChanged="cmbEntregaTenis_SelectionChanged"/>

                            <TextBlock x:Name="lblExistenciaTenis"
                                       Text="Disponibles: 0"
                                       FontWeight="Bold"
                                       Margin="0,0,0,15"/>

                            <Button x:Name="btnRegistrarEntregaTenis"
                                    Content="Registrar entrega de tenis"
                                    Height="40"
                                    IsEnabled="False"
                                    Click="BtnRegistrarEntregaTenis_Click"/>
                            
                        </StackPanel>
                        
                    </GroupBox>
                    
                </Grid>
                
            </TabItem>
            
            <!-- APARTADOS -->
            <TabItem Header="📦 Apartados">

                <TabControl Margin="10">

                    <TabItem Header="➕ Nuevo apartado">

                        <Grid Margin="15">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="220"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Nuevo apartado de canje"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Margin="0,0,0,15"/>

                            <!-- REFERENCIA -->
                            <StackPanel Grid.Row="1"
                                        Orientation="Horizontal"
                                        Margin="0,0,0,15">

                                <TextBlock Text="Referencia:"
                                       VerticalAlignment="Center"/>

                                <TextBox x:Name="txtReferenciaApartadoCanje"
                                     Width="350"
                                     Height="30"
                                     Margin="10,0"/>

                            </StackPanel>

                            <!-- TIPO -->
                            <TabControl Grid.Row="2">

                                <!-- ÚTILES -->
                                <TabItem Header="🎒 Útiles">

                                    <Grid Margin="15">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="Paquete:"
                                                   VerticalAlignment="Center"/>

                                        <ComboBox x:Name="cmbApartadoPaquete"
                                                  Grid.Column="1"
                                                  Height="30"
                                                  Margin="10,0"/>

                                        <TextBlock Grid.Column="2"
                                                   Text="Cantidad:"
                                                   VerticalAlignment="Center"
                                                   Margin="20,0,0,0"/>

                                        <TextBox x:Name="txtApartadoPaqueteCantidad"
                                                 Grid.Column="3"
                                                 Height="30"
                                                 Text="1"
                                                 Margin="10,0"/>

                                        <TextBlock x:Name="lblApartadoPaqueteExistencia"
                                                   Grid.Column="4"
                                                   Text="Disponibles: 0"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center"
                                                   Margin="20,0"/>

                                        <Button Grid.Column="5"
                                                Content="Agregar paquete"
                                                Width="140"
                                                Height="35"
                                                HorizontalAlignment="Left"
                                                Click="BtnAgregarApartadoPaquete_Click"/>

                                    </Grid>

                                </TabItem>

                                <!-- UNIFORMES -->
                                <TabItem Header="👕 Uniformes">

                                    <WrapPanel Margin="15">

                                        <TextBlock Text="Tipo:"
                                               VerticalAlignment="Center"/>

                                        <ComboBox x:Name="cmbApartadoUniformeTipo"
                                              Width="170"
                                              Height="30"
                                              Margin="10,0"
                                              SelectionChanged="cmbApartadoUniformeTipo_SelectionChanged"/>

                                        <TextBlock Text="Color:"
                                               VerticalAlignment="Center"
                                               Margin="15,0,0,0"/>

                                        <ComboBox x:Name="cmbApartadoUniformeColor"
                                              Width="120"
                                              Height="30"
                                              Margin="10,0"
                                              SelectionChanged="cmbApartadoUniformeColor_SelectionChanged"/>

                                        <TextBlock Text="Talla:"
                                               VerticalAlignment="Center"
                                               Margin="15,0,0,0"/>

                                        <ComboBox x:Name="cmbApartadoUniformeTalla"
                                              Width="100"
                                              Height="30"
                                              Margin="10,0"
                                              SelectionChanged="cmbApartadoUniformeTalla_SelectionChanged"/>

                                        <TextBlock x:Name="lblApartadoUniformeExistencia"
                                               Text="Disponibles: 0"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"
                                               Margin="20,0"/>

                                        <Button Content="Agregar uniforme"
                                            Width="140"
                                            Height="35"
                                            Click="BtnAgregarApartadoUniforme_Click"/>

                                    </WrapPanel>

                                </TabItem>

                                <!-- TENIS -->
                                <TabItem Header="👟 Tenis">

                                    <StackPanel Margin="15"
                                            Orientation="Horizontal">

                                        <TextBlock Text="Talla:"
                                               VerticalAlignment="Center"/>

                                        <ComboBox x:Name="cmbApartadoTenis"
                                              Width="120"
                                              Height="30"
                                              Margin="10,0"
                                              SelectionChanged="cmbApartadoTenis_SelectionChanged"/>

                                        <TextBlock x:Name="lblApartadoTenisExistencia"
                                               Text="Disponibles: 0"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"
                                               Margin="20,0"/>

                                        <Button Content="Agregar tenis"
                                            Width="140"
                                            Height="35"
                                            Click="BtnAgregarApartadoTenis_Click"/>

                                    </StackPanel>

                                </TabItem>

                            </TabControl>

                            <TextBlock Grid.Row="3"
                                   Text="Artículos apartados"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,15,0,5"/>

                            <!-- LISTA TEMPORAL -->
                            <DataGrid x:Name="dgNuevoApartadoCanje"
                                  Grid.Row="4"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True">

                                <DataGrid.Columns>

                                    <DataGridTextColumn Header="Tipo"
                                                    Binding="{Binding Tipo}"
                                                    Width="150"/>

                                    <DataGridTextColumn Header="Descripción"
                                                    Binding="{Binding Descripcion}"
                                                    Width="*"/>

                                    <DataGridTextColumn Header="Cantidad"
                                                    Binding="{Binding Cantidad}"
                                                    Width="100"/>

                                </DataGrid.Columns>

                            </DataGrid>

                            <Button Grid.Row="5"
                                Content="Registrar apartado"
                                Width="180"
                                Height="40"
                                HorizontalAlignment="Right"
                                Margin="0,10,0,0"
                                Click="BtnRegistrarApartadoCanje_Click"/>

                        </Grid>

                    </TabItem>

                    <!-- APARTADOS REGISTRADOS -->
                    <TabItem Header="📋 Apartados registrados">

                        <Grid Margin="15">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <WrapPanel Margin="0,0,0,15">

                                <Button Content="Pendientes"
                                        Width="100"
                                        Margin="0,0,5,0"
                                        Click="BtnApartadosCanjePendientes_Click"/>

                                <Button Content="Entregados"
                                        Width="100"
                                        Margin="5,0"
                                        Click="BtnApartadosCanjeEntregados_Click"/>

                                <Button Content="Cancelados"
                                        Width="100"
                                        Margin="5,0"
                                        Click="BtnApartadosCanjeCancelados_Click"/>

                                <Button Content="Todos"
                                        Width="90"
                                        Margin="5,0"
                                        Click="BtnApartadosCanjeTodos_Click"/>

                                <TextBlock Text="Buscar:"
                                           VerticalAlignment="Center"
                                           Margin="20,0,5,0"/>

                                <TextBox x:Name="txtBuscarApartadoCanje"
                                         Width="220"
                                         Height="30"
                                         TextChanged="txtBuscarApartadoCanje_TextChanged"/>

                            </WrapPanel>

                            <!-- LISTA -->
                            <DataGrid x:Name="dgApartadosCanjeRegistrados"
                                      Grid.Row="1"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      SelectionMode="Single">

                                <DataGrid.Columns>

                                    <DataGridTextColumn Header="Folio"
                                                        Binding="{Binding Id}"
                                                        Width="70"/>

                                    <DataGridTextColumn Header="Fecha"
                                                        Binding="{Binding Fecha,
                                                        StringFormat=dd/MM/yyyy HH:mm}"
                                                        Width="160"/>

                                    <DataGridTextColumn Header="Referencia"
                                                        Binding="{Binding Referencia}"
                                                        Width="*"/>

                                    <DataGridTextColumn Header="Estado"
                                                        Binding="{Binding Estado}"
                                                        Width="120"/>

                                    <DataGridTextColumn Header="Artículo"
                                                        Binding="{Binding CantidadArticulos}"
                                                        Width="100"/>

                                </DataGrid.Columns>

                            </DataGrid>

                            <!-- ACCIONES -->
                            <StackPanel Grid.Row="2"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Margin="0,15,0,0">

                                <Button Content="❌ Cancelar apartado"
                                        Width="170"
                                        Height="40"
                                        Margin="5"
                                        Click="BtnCancelarApartadoCanje_Click"/>

                                <Button Content="✅ Entregar apartado"
                                        Width="170"
                                        Height="40"
                                        Margin="5"
                                        Click="BtnEntregarApartadoCanje_Click"/>

                            </StackPanel>

                        </Grid>

                    </TabItem>

                </TabControl>

            </TabItem>

            <!-- VALES -->
            <TabItem Header="📋 Vales pendientes">
                <Grid Margin="15">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Prendas pendientes de entregar"
                            FontSize="20"
                            FontWeight="Bold"
                            Margin="0,0,0,15"/>

                    <DataGrid x:Name="dgVales"
                            Grid.Row="1"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Fecha"
                                                Binding="{Binding Fecha,
                                                StringFormat=dd/MM/yyyy HH:mm}"
                                                Width="150"/>

                            <DataGridTextColumn Header="Origen"
                                                Binding="{Binding Origen}"
                                                Width="100"/>

                            <DataGridTextColumn Header="Referencia"
                                                Binding="{Binding Referencia}"
                                                Width="110"/>

                            <DataGridTextColumn Header="Tipo"
                                                Binding="{Binding Tipo}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Color"
                                                Binding="{Binding Color}"
                                                Width="110"/>

                            <DataGridTextColumn Header="Talla"
                                                Binding="{Binding Talla}"
                                                Width="90"/>

                            <DataGridTemplateColumn Header="Acción"
                                                    Width="140">

                                <DataGridTemplateColumn.CellTemplate>

                                    <DataTemplate>

                                        <Button Content="Entregar vale"
                                                Tag="{Binding}"
                                                Click="BtnEntregarVale_Click"
                                                Margin="5"
                                                Padding="8.3"/>
                                        
                                    </DataTemplate>
                                    
                                </DataGridTemplateColumn.CellTemplate>
                                
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>

                    </DataGrid>

                </Grid>
            </TabItem>

            <!-- RESUMEN -->
            <TabItem Header="📊 Resumen">

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="15">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Resumen de la temporada"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Margin="0,0,0,15"/>

                        <!-- TARJETAS -->
                        <WrapPanel Grid.Row="1"
                                   Margin="0,0,0,20">

                            <Border BorderBrush="#CCCCCC"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="18"
                                    Margin="5"
                                    Width="190">

                                <StackPanel>
                                    <TextBlock Text="Paquetes entregados"
                                               FontWeight="Bold"
                                               TextAlignment="Center"/>

                                    <TextBlock x:Name="lblPaquetesEntregados"
                                               Text="0"
                                               FontSize="28"
                                               FontWeight="Bold"
                                               TextAlignment="Center"
                                               Margin="0,8,0,0"/>
                                </StackPanel>

                            </Border>

                            <Border BorderBrush="#CCCCCC"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="18"
                                    Margin="5"
                                    Width="190">

                                <StackPanel>
                                    <TextBlock Text="Canjes de uniformes"
                                               FontWeight="Bold"
                                               TextAlignment="Center"/>

                                    <TextBlock x:Name="lblCanjesUniforme"
                                               Text="0"
                                               FontSize="28"
                                               FontWeight="Bold"
                                               TextAlignment="Center"
                                               Margin="0,8,0,0"/>
                                </StackPanel>

                            </Border>

                            <Border BorderBrush="#CCCCCC"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="18"
                                    Margin="5"
                                    Width="190">

                                <StackPanel>
                                    <TextBlock Text="Conjuntos entregados"
                                               FontWeight="Bold"
                                               TextAlignment="Center"/>

                                    <TextBlock x:Name="lblConjuntosEntregados"
                                               Text="0"
                                               FontSize="28"
                                               FontWeight="Bold"
                                               TextAlignment="Center"
                                               Margin="0,8,0,0"/>
                                </StackPanel>

                            </Border>

                            <Border BorderBrush="#CCCCCC"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="18"
                                    Margin="5"
                                    Width="190">

                                <StackPanel>
                                    <TextBlock Text="Prendas entregadas"
                                               FontWeight="Bold"
                                               TextAlignment="Center"/>

                                    <TextBlock x:Name="lblPrendasEntregadas"
                                               Text="0"
                                               FontSize="28"
                                               FontWeight="Bold"
                                               TextAlignment="Center"
                                               Margin="0,8,0,0"/>

                                </StackPanel>

                            </Border>

                            <Border BorderBrush="#CCCCCC"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="18"
                                    Margin="5"
                                    Width="190">

                                <StackPanel>

                                    <TextBlock Text="Tenis entregados"
                                               FontWeight="Bold"
                                               TextAlignment="Center"/>

                                    <TextBlock x:Name="lblTenisEntregados"
                                               Text="0"
                                               FontSize="28"
                                               FontWeight="Bold"
                                               TextAlignment="Center"
                                               Margin="0,8,0,0"/>
                                    
                                </StackPanel>
                                
                            </Border>

                            <Border BorderBrush="#CCCCCC"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="18"
                                    Margin="5"
                                    Width="190">

                                <StackPanel>
                                    <TextBlock Text="Vales Pendientes"
                                               FontWeight="Bold"
                                               TextAlignment="Center"/>

                                    <TextBlock x:Name="lblValesPendientes"
                                               Text="0"
                                               FontSize="28"
                                               FontWeight="Bold"
                                               TextAlignment="Center"
                                               Margin="0,8,0,0"/>
                                </StackPanel>

                            </Border>

                        </WrapPanel>

                        <!-- SUBTÍTULOS -->
                        <Grid Grid.Row="2"
                              Margin="0,0,0,8">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="🎒 Resumen de paquetes"
                                       FontSize="18"
                                       FontWeight="Bold"/>

                            <TextBlock Grid.Column="2"
                                       Text="👕 Resumen uniformes"
                                       FontSize="18"
                                       FontWeight="Bold"/>

                            <TextBlock Grid.Column="4"
                                       Text="👟 Resumen tenis"
                                       FontSize="18"
                                       FontWeight="Bold"/>

                        </Grid>

                        <!-- TABLAS -->
                        <Grid Grid.Row="3">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <DataGrid x:Name="dgResumenPaquetes"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True">

                                <DataGrid.Columns>

                                    <DataGridTextColumn Header="Paquete"
                                                        Binding="{Binding NumeroPaquete}"
                                                        Width="*"/>

                                    <DataGridTextColumn Header="Disponibles"
                                                        Binding="{Binding Existencia}"
                                                        Width="*"/>

                                    <DataGridTextColumn Header="Entregados"
                                                        Binding="{Binding Entregados}"
                                                        Width="*"/>

                                    <DataGridTextColumn Header="Total recibido"
                                                        Binding="{Binding TotalRecibido}"
                                                        Width="*"/>

                                </DataGrid.Columns>

                            </DataGrid>

                            <DataGrid x:Name="dgResumenUniformes"
                                      Grid.Column="2"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True">

                                <DataGrid.Columns>

                                    <DataGridTextColumn Header="Tipo"
                                                        Binding="{Binding Tipo}"
                                                        Width="*"/>

                                    <DataGridTextColumn Header="Disponibles"
                                                        Binding="{Binding Existencia}"
                                                        Width="110"/>

                                    <DataGridTextColumn Header="Entregados"
                                                        Binding="{Binding Entregados}"
                                                        Width="110"/>

                                    <DataGridTextColumn Header="Total recibido"
                                                        Binding="{Binding TotalRecibido}"
                                                        Width="120"/>

                                </DataGrid.Columns>

                            </DataGrid>

                            <DataGrid x:Name="dgResumenTenis"
                                      Grid.Column="4"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True">
                                
                                <DataGrid.Columns>

                                    <DataGridTextColumn Header="Talla"
                                                        Binding="{Binding Talla}"
                                                        Width="*"/>

                                    <DataGridTextColumn Header="Disponibles"
                                                        Binding="{Binding Existencia}"
                                                        Width="100"/>

                                    <DataGridTextColumn Header="Entregados"
                                                        Binding="{Binding Entregados}"
                                                        Width="100"/>

                                    <DataGridTextColumn Header="Total recibido"
                                                        Binding="{Binding TotalRecibido}"
                                                        Width="110"/>
                                    
                                </DataGrid.Columns>
                                
                            </DataGrid>

                        </Grid>

                    </Grid>
                
                </ScrollViewer>
            
            </TabItem>

        </TabControl>

    </Grid>
    
</UserControl>
