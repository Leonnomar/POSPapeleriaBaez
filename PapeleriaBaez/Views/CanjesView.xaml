<UserControl x:Class="PapeleriaBaez.Views.CanjesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PapeleriaBaez.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="🎒 Canjes Escolares"
                   FontSize="28"
                   FontWeight="Bold"
                   Margin="0,0,0,15"/>

        <TabControl Grid.Row="1">

            <!-- ALTAS -->
            <TabItem Header="📥Altas">
                <Grid Margin="15">

                    <TabControl>

                        <TabItem Header="🎒 Útiles">
                            <Grid Margin="15">

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Entrada de paquetes"
                                        FontSize="20"
                                        FontWeight="Bold"/>

                                <StackPanel Grid.Row="1"
                                        Orientation="Horizontal"
                                        Margin="0,15">

                                    <TextBlock Text="Paquete:"
                                            VerticalAlignment="Center"/>

                                    <ComboBox x:Name="cmbPaquete"
                                            Width="150"
                                            Margin="10,0"/>

                                    <TextBlock Text="Cantidad recibida:"
                                            VerticalAlignment="Center"
                                            Margin="20,0,0,0"/>

                                    <TextBox x:Name="txtCantidadPaquete"
                                            Width="100"
                                            Height="30"
                                            Margin="10,0"/>

                                    <Button Content="Registrar entrada"
                                        Width="140"
                                        Margin="15,0"
                                        Click="BtnEntradaPaquete_Click"/>

                                </StackPanel>

                                <DataGrid x:Name="dgPaquetes"
                                        Grid.Row="2"
                                        AutoGenerateColumns="False"
                                        CanUserAddRows="False">

                                    <DataGrid.Columns>

                                        <DataGridTextColumn Header="Paquete"
                                                        Binding="{Binding NumeroPaquete}"
                                                        Width="*"/>

                                        <DataGridTextColumn Header="Existencia"
                                                        Binding="{Binding Existencia}"
                                                        Width="*"/>

                                        <DataGridTextColumn Header="Entregados"
                                                        Binding="{Binding Entregados}"
                                                        Width="*"/>

                                    </DataGrid.Columns>

                                </DataGrid>

                            </Grid>
                        </TabItem>

                        <TabItem Header="👕 Uniformes">
                            <Grid Margin="15">

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Entrada de Uniformes"
                                        FontSize="20"
                                        FontWeight="Bold"/>

                                <WrapPanel Grid.Row="1"
                                        Margin="0,15">

                                    <TextBlock Text="Tipo:"
                                            VerticalAlignment="Center"/>

                                    <ComboBox x:Name="cmbTipoUniforme"
                                            Width="175"
                                            Margin="10,0"
                                              IsEditable="False"
                                              SelectionChanged="cmbTipoUniforme_SelectionChanged"/>

                                    <TextBlock Text="Color:"
                                            VerticalAlignment="Center"/>

                                    <ComboBox x:Name="cmbColorUniforme"
                                            Width="120"
                                            Margin="10,0"
                                              IsEditable="False"/>

                                    <TextBlock Text="Talla:"
                                            VerticalAlignment="Center"/>

                                    <ComboBox x:Name="cmbTallaUniforme"
                                            Width="100"
                                            Margin="10,0"
                                              IsEditable="False"/>

                                    <TextBlock Text="Cantidad:"
                                            VerticalAlignment="Center"/>

                                    <TextBox x:Name="txtCantidadUniforme"
                                            Width="80"
                                            Height="30"
                                            Margin="10,0"/>

                                    <Button Content="Registrar Entrada"
                                        Width="140"
                                        Margin="10,0"
                                        Click="BtnEntradaUniforme_Click"/>

                                </WrapPanel>

                                <DataGrid x:Name="dgUniformes"
                                        Grid.Row="2"
                                        AutoGenerateColumns="False"
                                        CanUserAddRows="False">

                                    <DataGrid.Columns>

                                        <DataGridTextColumn Header="Tipo"
                                                        Binding="{Binding Tipo}"
                                                        Width="*"/>

                                        <DataGridTextColumn Header="Color"
                                                        Binding="{Binding Color}"
                                                        Width="*"/>

                                        <DataGridTextColumn Header="Talla"
                                                        Binding="{Binding Talla}"
                                                        Width="*"/>

                                        <DataGridTextColumn Header="Existencia"
                                                        Binding="{Binding Existencia}"
                                                        Width="*"/>

                                        <DataGridTextColumn Header="Entregados"
                                                        Binding="{Binding Entregados}"
                                                        Width="*"/>

                                    </DataGrid.Columns>

                                </DataGrid>

                            </Grid>
                        </TabItem>

                    </TabControl>

                </Grid>
            </TabItem>

            <!-- REGISTRAR -->
            <TabItem Header="✅ Registrar Canje">
                <Grid Margin="15">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <GroupBox Header="🎒 Canje de útiles"
                            Margin="0,0,10,0">

                        <StackPanel Margin="15">

                            <TextBlock Text="Paquete"/>

                            <ComboBox x:Name="cmbEntregaPaquete"
                                    Height="30"
                                    Margin="0,5,0,15"
                                    SelectionChanged="cmbEntregaPaquete_SelectionChanged"/>

                            <TextBlock Text="Cantidad"/>

                            <TextBox x:Name="txtEntregaPaquete"
                                     Height="30"
                                     Text="1"
                                     Margin="0,5,0,15"
                                     TextChanged="txtEntregaPaquete_TextChanged"
                                     PreviewTextInput="SoloEnteros_PreviewTextInput"/>

                            <TextBlock x:Name="lblExistenciaPaquete"
                                    Text="Disponibles: 0"
                                    FontWeight="Bold"
                                    Margin="0,0,0,15"/>

                            <Button x:Name="btnRegistrarEntregaPaquete"
                                    Content="Registrar entrega de útiles"
                                    Height="40"
                                    IsEnabled="False"
                                    Click="BtnRegistrarEntregaPaquete_Click"/>

                        </StackPanel>

                    </GroupBox>

                    <GroupBox Grid.Column="1"
                            Header="👕 Canje de uniformes"
                            Margin="10,0,0,0">

                        <StackPanel Margin="15">

                            <TextBlock Text="Cantidad de conjuntos"
                                    FontWeight="Bold"/>

                            <StackPanel Orientation="Horizontal"
                                    Margin="0,10,0,15">

                                <RadioButton x:Name="rbUnConjunto"
                                            Content="1 conjunto"
                                            IsChecked="True"
                                            Margin="0,0,20,0"/>

                                <RadioButton x:Name="rbDosConjuntos"
                                            Content="2 conjuntos"/>

                            </StackPanel>

                            <Button Content="Captura conjuntos"
                                Height="40"
                                Click="BtnCapturarConjuntos_Click"/>

                        </StackPanel>

                    </GroupBox>

                </Grid>
            </TabItem>

            <!-- VALES -->
            <TabItem Header="📋 Vales pendientes">
                <Grid Margin="15">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Prendas pendientes de entregar"
                            FontSize="20"
                            FontWeight="Bold"
                            Margin="0,0,0,15"/>

                    <DataGrid x:Name="dgVales"
                            Grid.Row="1"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Fecha"
                                            Binding="{Binding Fecha}"
                                            Width="160"/>

                            <DataGridTextColumn Header="Conjunto"
                                            Binding="{Binding NumeroCoonjunto}"
                                            Width="90"/>

                            <DataGridTextColumn Header="Tipo"
                                            Binding="{Binding Tipo}"
                                            Width="*"/>

                            <DataGridTextColumn Header="Color"
                                            Binding="{Binding Color}"
                                            Width="120"/>

                            <DataGridTextColumn Header="Talla"
                                            Binding="{Binding Talla}"
                                            Width="90"/>

                            <DataGridTemplateColumn Header="Acción"
                                                    Width="140">

                                <DataGridTemplateColumn.CellTemplate>

                                    <DataTemplate>

                                        <Button Content="Entregar vale"
                                                Tag="{Binding}"
                                                Click="BtnEntregarVale_Click"
                                                Margin="5"
                                                Padding="8,3"/>
                                        
                                    </DataTemplate>
                                    
                                </DataGridTemplateColumn.CellTemplate>
                                
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>

                    </DataGrid>

                </Grid>
            </TabItem>

            <!-- RESUMEN -->
            <TabItem Header="📊 Resumen">

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="15">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Resumen de la temporada"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Margin="0,0,0,15"/>

                        <!-- TARJETAS -->
                        <WrapPanel Grid.Row="1"
                                   Margin="0,0,0,20">

                            <Border BorderBrush="#CCCCCC"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="18"
                                    Margin="5"
                                    Width="190">

                                <StackPanel>
                                    <TextBlock Text="Paquetes entregados"
                                               FontWeight="Bold"
                                               TextAlignment="Center"/>

                                    <TextBlock x:Name="lblPaquetesEntregados"
                                               Text="0"
                                               FontSize="28"
                                               FontWeight="Bold"
                                               TextAlignment="Center"
                                               Margin="0,8,0,0"/>
                                </StackPanel>

                            </Border>

                            <Border BorderBrush="#CCCCCC"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="18"
                                    Margin="5"
                                    Width="190">

                                <StackPanel>
                                    <TextBlock Text="Canjes de uniformes"
                                               FontWeight="Bold"
                                               TextAlignment="Center"/>

                                    <TextBlock x:Name="lblCanjesUniforme"
                                               Text="0"
                                               FontSize="28"
                                               FontWeight="Bold"
                                               TextAlignment="Center"
                                               Margin="0,8,0,0"/>
                                </StackPanel>

                            </Border>

                            <Border BorderBrush="#CCCCCC"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="18"
                                    Margin="5"
                                    Width="190">

                                <StackPanel>
                                    <TextBlock Text="Conjuntos entregados"
                                               FontWeight="Bold"
                                               TextAlignment="Center"/>

                                    <TextBlock x:Name="lblConjuntosEntregados"
                                               Text="0"
                                               FontSize="28"
                                               FontWeight="Bold"
                                               TextAlignment="Center"
                                               Margin="0,8,0,0"/>
                                </StackPanel>

                            </Border>

                            <Border BorderBrush="#CCCCCC"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="18"
                                    Margin="5"
                                    Width="190">

                                <StackPanel>
                                    <TextBlock Text="Prendas entregadas"
                                               FontWeight="Bold"
                                               TextAlignment="Center"/>

                                    <TextBlock x:Name="lblPrendasEntregadas"
                                               Text="0"
                                               FontSize="28"
                                               FontWeight="Bold"
                                               TextAlignment="Center"
                                               Margin="0,8,0,0"/>

                                </StackPanel>

                            </Border>

                            <Border BorderBrush="#CCCCCC"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="18"
                                    Margin="5"
                                    Width="190">

                                <StackPanel>
                                    <TextBlock Text="Vales Pendientes"
                                               FontWeight="Bold"
                                               TextAlignment="Center"/>

                                    <TextBlock x:Name="lblValesPendientes"
                                               Text="0"
                                               FontSize="28"
                                               FontWeight="Bold"
                                               TextAlignment="Center"
                                               Margin="0,8,0,0"/>
                                </StackPanel>

                            </Border>

                        </WrapPanel>

                        <!-- SUBTÍTULOS -->
                        <Grid Grid.Row="2"
                              Margin="0,0,0,8">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="🎒 Resumen de paquetes"
                                       FontSize="18"
                                       FontWeight="Bold"/>

                            <TextBlock Grid.Column="2"
                                       Text="👕 Resumen uniformes"
                                       FontSize="18"
                                       FontWeight="Bold"/>

                        </Grid>

                        <!-- TABLAS -->
                        <Grid Grid.Row="3">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <DataGrid x:Name="dgResumenPaquetes"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True">

                                <DataGrid.Columns>

                                    <DataGridTextColumn Header="Paquete"
                                                        Binding="{Binding NumeroPaquete}"
                                                        Width="*"/>

                                    <DataGridTextColumn Header="Disponibles"
                                                        Binding="{Binding Existencia}"
                                                        Width="*"/>

                                    <DataGridTextColumn Header="Entregados"
                                                        Binding="{Binding Entregados}"
                                                        Width="*"/>

                                    <DataGridTextColumn Header="Total recibido"
                                                        Binding="{Binding TotalRecibido}"
                                                        Width="*"/>

                                </DataGrid.Columns>

                            </DataGrid>

                            <DataGrid x:Name="dgResumenUniformes"
                                      Grid.Column="2"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True">

                                <DataGrid.Columns>

                                    <DataGridTextColumn Header="Tipo"
                                                        Binding="{Binding Tipo}"
                                                        Width="*"/>

                                    <DataGridTextColumn Header="Disponibles"
                                                        Binding="{Binding Existencia}"
                                                        Width="110"/>

                                    <DataGridTextColumn Header="Entregados"
                                                        Binding="{Binding Entregados}"
                                                        Width="110"/>

                                    <DataGridTextColumn Header="Total recibido"
                                                        Binding="{Binding TotalRecibido}"
                                                        Width="120"/>

                                </DataGrid.Columns>

                            </DataGrid>

                        </Grid>

                    </Grid>
                
                </ScrollViewer>
            
            </TabItem>

        </TabControl>

    </Grid>
    
</UserControl>
