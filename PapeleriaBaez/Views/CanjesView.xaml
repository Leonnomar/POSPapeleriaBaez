<UserControl x:Class="PapeleriaBaez.Views.CanjesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PapeleriaBaez.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="🎒 Canjes"
                   FontSize="28"
                   FontWeight="Bold"
                   Margin="0,0,0,15"/>

        <TabControl Grid.Row="1">

            <TabItem Header="🎒 Útiles">
                <Grid Margin="15">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Entrada de paquetes"
                               FontSize="20"
                               FontWeight="Bold"/>

                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                Margin="0,15">

                        <TextBlock Text="Paquete:"
                                   VerticalAlignment="Center"/>

                        <ComboBox x:Name="cmbPaquete"
                                  Width="150"
                                  Margin="10,0"/>

                        <TextBlock Text="Cantidad recibida:"
                                   VerticalAlignment="Center"
                                   Margin="20,0,0,0"/>

                        <TextBox x:Name="txtCantidadPaquete"
                                 Width="100"
                                 Height="30"
                                 Margin="10,0"/>

                        <Button Content="Registrar entrada"
                                Width="140"
                                Margin="15,0"
                                Click="BtnEntradaPaquete_Click"/>
                        
                    </StackPanel>

                    <DataGrid x:Name="dgPaquetes"
                              Grid.Row="2"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Paquete"
                                                Binding="{Binding NumeroPaquete}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Existencia"
                                                Binding="{Binding Existencia}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Entregados"
                                                Binding="{Binding Entregados}"
                                                Width="*"/>
                            
                        </DataGrid.Columns>
                        
                    </DataGrid>
                    
                </Grid>
            </TabItem>

            <TabItem Header="👕 Uniformes">
                <Grid Margin="15">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Entrada de Uniformes"
                               FontSize="20"
                               FontWeight="Bold"/>

                    <WrapPanel Grid.Row="1"
                               Margin="0,15">

                        <TextBlock Text="Tipo:"
                                   VerticalAlignment="Center"/>

                        <ComboBox x:Name="cmbTipoUniforme"
                                  Width="140"
                                  Margin="10,0"/>

                        <TextBlock Text="Color:"
                                   VerticalAlignment="Center"/>

                        <ComboBox x:Name="cmbColorUniforme"
                                  Width="120"
                                  Margin="10,0"/>

                        <TextBlock Text="Talla:"
                                   VerticalAlignment="Center"/>

                        <ComboBox x:Name="cmbTallaUniforme"
                                  Width="100"
                                  Margin="10,0"/>

                        <TextBlock Text="Cantidad:"
                                   VerticalAlignment="Center"/>

                        <TextBox x:Name="txtCantidadUniforme"
                                 Width="80"
                                 Height="30"
                                 Margin="10,0"/>

                        <Button Content="Registrar Entrada"
                                Width="140"
                                Margin="10,0"
                                Click="BtnEntradaUniforme_Click"/>
                        
                    </WrapPanel>

                    <DataGrid x:Name="dgUniformes"
                              Grid.Row="2"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Tipo"
                                                Binding="{Binding Tipo}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Color"
                                                Binding="{Binding Color}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Talla"
                                                Binding="{Binding Talla}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Existencia"
                                                Binding="{Binding Existencia}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Entregados"
                                                Binding="{Binding Entregados}"
                                                Width="*"/>
                            
                        </DataGrid.Columns>
                        
                    </DataGrid>
                    
                </Grid>
            </TabItem>
            
        </TabControl>
        
    </Grid>
    
</UserControl>
