<UserControl x:Class="PapeleriaBaez.Views.ApartadosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PapeleriaBaez.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="📦 Apartados"
                   FontSize="28"
                   FontWeight="Bold"
                   Margin="0,0,0,15"/>
        
        <!-- DATOS DEL CLENTE -->
        <Grid Grid.Row="1"
              Margin="0,0,0,10">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Cliente:"
                       VerticalAlignment="Center"/>

            <TextBox x:Name="txtCliente"
                     Grid.Column="1"
                     Height="30"
                     Margin="10,0"/>

            <TextBlock Grid.Column="2"
                       Text="Anticipo:"
                       VerticalAlignment="Center"
                       Margin="20,0,0,0"/>

            <TextBox x:Name="txtAnticipo"
                     Grid.Column="3"
                     Height="30"
                     Margin="10,0"
                     Text="0"
                     TextChanged="txtAnticipo_TextChanged"/>

        </Grid>
        
        <!-- BÚSQUEDA -->
        <Grid Grid.Row="2"
              Margin="0,0,0,10">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Buscar:"
                       VerticalAlignment="Center"/>

            <TextBox x:Name="txtBuscar"
                     Grid.Column="1"
                     Height="30"
                     Margin="10,0"
                     TextChanged="txtBuscar_TextChanged"
                     KeyDown="txtBuscar_KeyDown"/>

            <Border x:Name="panelResultados"
                    Grid.Column="1"
                    Margin="10,35,0,0"
                    Background="White"
                    BorderBrush="#BFBFBF"
                    BorderThickness="1"
                    Visibility="Collapsed"
                    Panel.ZIndex="100">

                <ListBox x:Name="lstResultados"
                         MaxHeight="220"
                         MouseDoubleClick="lstResultados_MouseDoubleClick"
                         KeyDown="lstResultados_KeyDown"/>
                
            </Border>
            
        </Grid>
        
        <!-- CARRITO -->
        <DataGrid x:Name="dgApartado"
                  Grid.Row="3"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="False">

            <DataGrid.Columns>

                <DataGridTextColumn Header="Código"
                                    Binding="{Binding Codigo}"
                                    Width="110"/>

                <DataGridTextColumn Header="Producto"
                                    Binding="{Binding Nombre}"
                                    Width="*"/>

                <DataGridTextColumn Header="Cantidad"
                                    Binding="{Binding Cantidad}"
                                    Width="90"/>

                <DataGridTextColumn Header="Precio"
                                    Binding="{Binding Precio,
                                    StringFormat={}{0:C}}"
                                    Width="100"/>

                <DataGridTextColumn Header="Importe"
                                    Binding="{Binding Importe,
                                    StringFormat={}{0:C}}"
                                    Width="120"/>
                
            </DataGrid.Columns>
            
        </DataGrid>
        
        <!-- TOTALES Y BOTONES -->
        <Grid Grid.Row="4"
              Margin="0,15,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>

                <TextBlock x:Name="lblTotal"
                           Text="Total: $0.00"
                           FontSize="20"
                           FontWeight="Bold"/>

                <TextBlock x:Name="lblSaldo"
                           Text="Saldo: $0.00"
                           FontSize="18"/>
                
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal">

                <Button Content="Cancelar"
                        Width="120"
                        Height="40"
                        Margin="5"
                        Click="BtnCancelar_Click"/>

                <Button Content="Registrar Apartado"
                        Width="160"
                        Height="40"
                        Margin="5"
                        Click="BtnRegistrarApartado_Click"/>
                
            </StackPanel>
            
        </Grid>
        
    </Grid>
    
</UserControl>
