<UserControl x:Class="PapeleriaBaez.Views.ApartadosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PapeleriaBaez.Views"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="1000">

    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="📦 Apartados"
                   FontSize="28"
                   FontWeight="Bold"
                   Margin="0,0,0,15"/>

        <TabControl Grid.Row="1">

            <!-- NUEVO APARTADO -->
            <TabItem Header="➕ Crear Apartado">

                <Grid Margin="15">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- DATOS DEL CLIENTE -->
                    <Grid Grid.Row="0"
                          Margin="0,0,0,15">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Cliente:"
                                   VerticalAlignment="Center"/>

                        <TextBox x:Name="txtCliente"
                                 Grid.Column="1"
                                 Height="30"
                                 Margin="10,0"/>

                        <TextBlock Grid.Column="2"
                                   Text="Anticipo:"
                                   VerticalAlignment="Center"
                                   Margin="20,0,0,0"/>

                        <TextBox x:Name="txtAnticipo"
                                 Grid.Column="3"
                                 Height="30"
                                 Margin="10,0"
                                 Text="0"
                                 TextChanged="txtAnticipo_TextChanged"/>

                    </Grid>

                    <!-- BÚSQUEDA -->
                    <Grid Grid.Row="1"
                          Margin="0,0,0,15">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Buscar:"
                                   VerticalAlignment="Center"/>
    
                        <TextBox x:Name="txtBuscar"
                                 Grid.Column="1"
                                 Height="30"
                                 Margin="10,0"
                                 TextChanged="txtBuscar_TextChanged"
                                 KeyDown="txtBuscar_KeyDown"/>

                        <Border x:Name="panelResultados"
                                Grid.Column="1"
                                Margin="10,35,0,0"
                                Background="White"
                                BorderBrush="#BFBFBF"
                                BorderThickness="1"
                                Visibility="Collapsed"
                                Panel.ZIndex="100">

                            <ListBox x:Name="lstResultados"
                                     MaxHeight="220"
                                     MouseDoubleClick="lstResultados_MouseDoubleClick"
                                     KeyDown="lstResultados_KeyDown">

                                <ListBox.ItemTemplate>

                                    <DataTemplate>

                                        <StackPanel Orientation="Horizontal"
                                                    Margin="5">

                                            <TextBlock Text="{Binding Codigo}"
                                                       FontWeight="Bold"/>

                                            <TextBlock Text=" - "/>

                                            <TextBlock Text="{Binding Nombre}"/>

                                            <TextBlock Text=" - "
                                                       Margin="5,0"/>

                                            <TextBlock Text="{Binding PrecioVenta,
                                                       StringFormat={}{0:C}}"/>

                                            <TextBlock Text=" - Stock: "
                                                       Margin="5,0,0,0"/>

                                            <TextBlock Text="{Binding Stock}"/>

                                        </StackPanel>
                                        
                                    </DataTemplate>
                                    
                                </ListBox.ItemTemplate>
                                
                            </ListBox>
    
                        </Border>

                    </Grid>

                    <!-- CARRITO -->
                    <DataGrid x:Name="dgApartado"
                              Grid.Row="2"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="False">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Código"
                                                Binding="{Binding Codigo}"
                                                Width="110"/>

                            <DataGridTextColumn Header="Producto"
                                                Binding="{Binding Nombre}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Cantidad"
                                                Binding="{Binding Cantidad}"
                                                Width="90"/>

                            <DataGridTextColumn Header="Precio"
                                                Binding="{Binding Precio,
                                                StringFormat={}{0:C}}"
                                                Width="100"/>

                            <DataGridTextColumn Header="Importe"
                                                Binding="{Binding Importe,
                                                StringFormat={}{0:C}}"
                                                Width="120"/>

                        </DataGrid.Columns>

                    </DataGrid>

                    <!-- TOTALES Y BOTONES -->
                    <Grid Grid.Row="3"
                      Margin="0,15,0,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>

                            <TextBlock x:Name="lblTotal"
                                   Text="Total: $0.00"
                                   FontSize="20"
                                   FontWeight="Bold"/>

                            <TextBlock x:Name="lblSaldo"
                                   Text="Saldo: $0.00"
                                   FontSize="18"/>

                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                Orientation="Horizontal">

                            <Button Content="Cancelar"
                                Width="120"
                                Height="40"
                                Margin="5"
                                Click="BtnCancelar_Click"/>

                            <Button Content="Registrar Apartado"
                                Width="160"
                                Height="40"
                                Margin="5"
                                Click="BtnRegistrarApartado_Click"/>

                        </StackPanel>

                    </Grid>

                </Grid>

            </TabItem>

            <!-- APARTADOS REGISTRADOS -->
            <TabItem Header="📋Apartados registrados">

                <Grid Margin="15">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- FILTROS -->
                    <WrapPanel Margin="0,0,0,15">

                        <Button Content="Pendientes"
                                Width="100"
                                Margin="0,0,5,0"
                                Click="BtnApartadosPendientes_Click"/>

                        <Button Content="Entregados"
                                Width="100"
                                Margin="5,0"
                                Click="BtnApartadosEntregados_Click"/>

                        <Button Content="Cancelados"
                                Width="100"
                                Margin="5,0"
                                Click="BtnApartadosCancelados_Click"/>

                        <Button Content="Todos"
                                Width="90"
                                Margin="5,0"
                                Click="BtnApartadosTodos_Click"/>

                        <TextBlock Text="Buscar:"
                                   VerticalAlignment="Center"
                                   Margin="20,0,5,0"/>

                        <TextBox x:Name="txtBuscarApartado"
                                 Width="220"
                                 Height="30"
                                 TextChanged="txtBuscarApartado_TextChanged"/>
                        
                    </WrapPanel>

                    <!-- CONTENIDO -->
                    <Grid Grid.Row="1">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- LISTA -->
                        <GroupBox Grid.Column="0"
                                  Header="Apartados">

                            <DataGrid x:Name="dgApartadosRegistrados"
                                      Margin="10"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      SelectionMode="Single"
                                      SelectionChanged="dgApartadosRegistrados_SelectionChanged">

                                <DataGrid.Columns>

                                    <DataGridTextColumn Header="Folio"
                                                        Binding="{Binding Id}"
                                                        Width="70"/>

                                    <DataGridTextColumn Header="Cliente"
                                                        Binding="{Binding Cliente}"
                                                        Width="*"/>

                                    <DataGridTextColumn Header="Fecha"
                                                        Binding="{Binding Fecha,
                                                        StringFormat=dd/MM/yyyy}"
                                                        Width="110"/>

                                    <DataGridTextColumn Header="Total"
                                                        Binding="{Binding Total,
                                                        StringFormat={}{0:C}}"
                                                        Width="100"/>

                                    <DataGridTextColumn Header="Pagado"
                                                        Binding="{Binding Pagado,
                                                        StringFormat={}{0:C}}"
                                                        Width="100"/>

                                    <DataGridTextColumn Header="Saldo"
                                                        Binding="{Binding SaldoPendiente,
                                                        StringFormat={}{0:C}}"
                                                        Width="100"/>

                                    <DataGridTextColumn Header="Estado"
                                                        Binding="{Binding Estado}"
                                                        Width="100"/>
                                    
                                </DataGrid.Columns>
                                
                            </DataGrid>
                            
                        </GroupBox>
                        
                        <!-- DETALLE -->
                        <GroupBox Grid.Column="2"
                                  Header="Detalle / Abonos">

                            <Grid Margin="10">

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock x:Name="lblApartadoSeleccionado"
                                           Text="Seleccione un apartado"
                                           FontSize="16"
                                           FontWeight="Bold"/>

                                <TextBlock x:Name="lblSaldoApartado"
                                           Grid.Row="1"
                                           Text="Saldo: $0.00"
                                           FontSize="18"
                                           Margin="0,10,0,10"/>

                                <!-- ABONO -->
                                <StackPanel Grid.Row="2"
                                            Orientation="Horizontal"
                                            Margin="0,0,0,10">

                                    <TextBlock Text="Abono:"
                                               VerticalAlignment="Center"/>

                                    <TextBox x:Name="txtAbonoApartado"
                                             Width="100"
                                             Height="30"
                                             Margin="10,0"/>

                                    <Button Content="Registrar"
                                            Width="100"
                                            Click="BtnRegistrarAbonoApartado_Click"/>
                                    
                                </StackPanel>

                                <!-- HISTORIAL -->
                                <DataGrid x:Name="dgAbonosApartado"
                                          Grid.Row="3"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          IsReadOnly="True">

                                    <DataGrid.Columns>

                                        <DataGridTextColumn Header="Fecha"
                                                            Binding="{Binding Fecha,
                                                            StringFormat=dd/MM/yyyy HH:mm}"
                                                            Width="*"/>

                                        <DataGridTextColumn Header="Monto"
                                                            Binding="{Binding Monto,
                                                            StringFormat={}{0:C}}"
                                                            Width="100"/>
                                        
                                    </DataGrid.Columns>
                                    
                                </DataGrid>

                                <!-- ACCIONES -->
                                <StackPanel Grid.Row="4"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            Margin="0,10,0,0">

                                    <Button Content="❌ Cancelar apartado"
                                            Width="150"
                                            Margin="5"
                                            Click="BtnCancelarApartado_Click"/>

                                    <Button Content="✅ Entregar apartado"
                                            Width="150"
                                            Margin="5"
                                            Click="BtnEntregarApartado_Click"/>
                                    
                                </StackPanel>
                                
                            </Grid>
                            
                        </GroupBox>
                        
                    </Grid>
                    
                </Grid>
                
            </TabItem>

        </TabControl>

    </Grid>

</UserControl>
