<UserControl x:Class="PapeleriaBaez.Views.ReporteVentasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PapeleriaBaez.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Título -->
        <TextBlock Text="📊 Reporte de Ventas"
                   FontSize="28"
                   FontWeight="Bold"/>
        
        <!-- Filtros -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0,15">

            <TextBlock Text="Desde:"
                       VerticalAlignment="Center"/>


            <DatePicker x:Name="dpDesde"
                        Width="140"
                        Margin="5"/>

            <TextBlock Text="Hasta:"
                       Margin="20,0,0,0"
                       VerticalAlignment="Center"/>

            <DatePicker x:Name="dpHasta"
                        Width="140"
                        Margin="5"/>

            <Button Content="Buscar"
                    Width="100"
                    Margin="20,0,0,0"
                    Click="BtnBuscar_Click"/>

            <Button Content="📄 Exportar Excel"
                    Width="140"
                    Margin="10,0,0,0"
                    Click="BtnExportarExcel_Click"/>

        </StackPanel>
        
        <!-- CONTENIDO PRINCIPAL -->
        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- IZQUIERDA: Ventas y detalle -->
            <Grid Grid.Column="0">

                <Grid.RowDefinitions>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- Ventas -->
                <DataGrid x:Name="dgVentas"
                          Grid.Row="0"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionChanged="dgVentas_SelectionChanged">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Folio"
                                            Binding="{Binding Id}"
                                            Width="80"/>

                        <DataGridTextColumn Header="Fecha"
                                            Binding="{Binding Fecha,
                                            StringFormat=dd/MM/yyyy HH:mm}"
                                            Width="180"/>

                        <DataGridTextColumn Header="Productos"
                                            Binding="{Binding Productos}"
                                            Width="100"/>

                        <DataGridTextColumn Header="Total"
                                            Binding="{Binding Total,
                                            StringFormat={}{0:C}}"
                                            Width="120"/>
                        
                    </DataGrid.Columns>
                    
                </DataGrid>

                <TextBlock Grid.Row="1"
                           Text="Detalle de la venta"
                           FontSize="18"
                           FontWeight="Bold"
                           Margin="0,15,0,5"/>
                
                <!-- Detalle -->
                <DataGrid x:Name="dgDetalle"
                          Grid.Row="2"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Código"
                                            Binding="{Binding Codigo}"
                                            Width="100"/>

                        <DataGridTextColumn Header="Producto"
                                            Binding="{Binding Producto}"
                                            Width="*"/>

                        <DataGridTextColumn Header="Cantidad"
                                            Binding="{Binding Cantidad}"
                                            Width="80"/>

                        <DataGridTextColumn Header="Precio"
                                            Binding="{Binding Precio,
                                            StringFormat={}{0:C}}"
                                            Width="100"/>

                        <DataGridTextColumn Header="Importe"
                                            Binding="{Binding Importe,
                                            StringFormat={}{0:C}}"
                                            Width="110"/>
                        
                    </DataGrid.Columns>
                    
                </DataGrid>
                
            </Grid>
            
            <!-- DERECHA: Más vendidos -->
            <GroupBox Grid.Column="2"
                      Header="🏆 Productos más vendidos"
                      FontSize="16"
                      FontWeight="Bold">

                <DataGrid x:Name="dgMasVendidos"
                          Margin="10"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Producto"
                                            Binding="{Binding Producto}"
                                            Width="*"/>

                        <DataGridTextColumn Header="Vendidos"
                                            Binding="{Binding Cantidad}"
                                            Width="80"/>

                        <DataGridTextColumn Header="Ingresos"
                                            Binding="{Binding Ingresos,
                                            StringFormat={}{0:C}}"
                                            Width="90"/>
                        
                    </DataGrid.Columns>
                    
                </DataGrid>
                
            </GroupBox>
        </Grid>
        
        <!-- Resumen -->
        <TextBlock x:Name="lblResumen"
                   Grid.Row="3"
                   HorizontalAlignment="Right"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Margin="0,15,0,0"/>

    </Grid>
    
</UserControl>
