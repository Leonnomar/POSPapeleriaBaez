<Window x:Class="PapeleriaBaez.Views.NuevoServicioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PapeleriaBaez.Views"
        mc:Ignorable="d"
        Title="Nuevo servicio"
        Height="550"
        Width="650"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    
    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        
        <!-- TÍTULO -->
        <StackPanel Grid.Row="0"
                    Margin="0,0,0,20">

            <TextBlock Text="🛠️ Nuevo servicio"
                       FontSize="26"
                       FontWeight="Bold"/>

            <TextBlock Text="Registra un nuevo servicio para Papelería Báez"
                       Foreground="Gray"
                       FontSize="14"
                       Margin="0,5,0,0"/>
            
        </StackPanel>
        
        
        <!-- FORMULARIO -->
        <Grid Grid.Row="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            
            <!-- NOMBRE -->
            <TextBlock Grid.Row="0"
                       Grid.Column="0"
                       Text="Nombre:"
                       VerticalAlignment="Center"
                       FontSize="15"
                       Margin="0,0,10,15"/>

            <TextBox x:Name="txtNombre"
                     Grid.Row="0"
                     Grid.Column="1"
                     Height="35"
                     FontSize="15"
                     Margin="0,0,0,15"
                     VerticalContentAlignment="Center"/>
            
            
            <!-- CATEGORÍA -->
            <TextBlock Grid.Row="1"
                       Grid.Column="0"
                       Text="Categoría:"
                       VerticalAlignment="Center"
                       FontSize="15"
                       Margin="0,0,10,15"/>

            <ComboBox x:Name="cmbCategoria"
                      Grid.Row="1"
                      Grid.Column="1"
                      Height="35"
                      FontSize="15"
                      Margin="0,0,0,15"
                      VerticalContentAlignment="Center"/>
            
            
            <!-- DESCRIPCIÓN -->
            <TextBlock Grid.Row="2"
                       Grid.Column="0"
                       Text="Descripción:"
                       VerticalAlignment="Top"
                       FontSize="15"
                       Margin="0,5,0,15"/>

            <TextBox x:Name="txtDescripcion"
                     Grid.Row="2"
                     Grid.Column="1"
                     Height="70"
                     FontSize="15"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     Margin="0,0,0,15"/>
            
            
            <!-- PRECIO -->
            <TextBlock Grid.Row="3"
                       Grid.Column="0"
                       Text="Precio base:"
                       VerticalAlignment="Center"
                       FontSize="15"
                       Margin="0,0,0,15"/>

            <TextBox x:Name="txtPrecioBase"
                     Grid.Row="3"
                     Grid.Column="1"
                     Height="35"
                     FontSize="15"
                     Margin="0,0,0,15"
                     VerticalContentAlignment="Center"/>
            
            
            <!-- PRECIO MANUAL -->
            <TextBlock Grid.Row="4"
                       Grid.Column="0"
                       Text="Precio manual:"
                       VerticalAlignment="Center"
                       FontSize="15"
                       Margin="0,0,10,15"/>

            <CheckBox x:Name="chkPrecioManual"
                      Grid.Row="4"
                      Grid.Column="1"
                      Content="Permitir modificar el precio al cobrar"
                      VerticalAlignment="Center"
                      FontSize="14"
                      Margin="0,0,0,15"/>
        </Grid>
        
        
        <!-- BOTONES -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button Content="Cancelar"
                    Width="110"
                    Height="40"
                    Margin="0,0,10,0"
                    Click="BtnCancelar_Click"/>

            <Button Content="💾 Guardar"
                    Width="130"
                    Height="40"
                    FontSize="15"
                    Click="BtnGuardar_Click"/>
            
        </StackPanel>
        
    </Grid>
    
</Window>
