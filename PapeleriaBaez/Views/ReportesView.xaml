<UserControl x:Class="PapeleriaBaez.Views.ReportesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PapeleriaBaez.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="📊 Reportes"
                   FontSize="28"
                   FontWeight="Bold"
                   Margin="0,0,0,15"/>

        <TabControl Grid.Row="1">

            <!-- ================= VENTAS ================= -->
            <TabItem Header="🛒 Ventas">

                <Grid Margin="15">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- FILTROS -->
                    <WrapPanel Margin="0,0,0,15">

                        <TextBlock Text="Desde:"
                                   VerticalAlignment="Center"/>

                        <DatePicker x:Name="dpVentasDesde"
                                    Width="140"
                                    Margin="5"/>

                        <TextBlock Text="Hasta:"
                                   VerticalAlignment="Center"
                                   Margin="15,0,0,0"/>

                        <DatePicker x:Name="dpVentasHasta"
                                    Width="140"
                                    Margin="5"/>

                        <Button Content="Buscar"
                                Width="90"
                                Margin="10,0"
                                Click="BtnBuscarVentas_Click"/>

                        <Button Content="Hoy"
                                Width="75"
                                Margin="5,0"
                                Click="BtnVentasHoy_Click"/>

                        <Button Content="Semana"
                                Width="85"
                                Margin="5,0"
                                Click="BtnVentasSemana_Click"/>

                        <Button Content="Mes"
                                Width="75"
                                Margin="5,0"
                                Click="BtnVentasMes_Click"/>

                        <Button Content="📄 Exportar Excel"
                                Width="140"
                                Margin="15,0"
                                Click="BtnExportarVentas_Click"/>
                        
                    </WrapPanel>
                    
                    <!-- CONTENIDO -->
                    <Grid Grid.Row="1">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- IZQUIERDA -->
                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="2*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <DataGrid x:Name="dgVentas"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      SelectionMode="Single"
                                      SelectionChanged="dgVentas_SelectionChanged">

                                <DataGrid.Columns>

                                    <DataGridTextColumn Header="Folio"
                                                        Binding="{Binding Id}"
                                                        Width="70"/>

                                    <DataGridTextColumn Header="Fecha"
                                                        Binding="{Binding Fecha,
                                                        StringFormat=dd/MM/yyyy HH:mm}"
                                                        Width="170"/>

                                    <DataGridTextColumn Header="Productos"
                                                        Binding="{Binding Productos}"
                                                        Width="90"/>

                                    <DataGridTextColumn Header="Total"
                                                        Binding="{Binding Total,
                                                        StringFormat={}{0:C}}"
                                                        Width="110"/>
                                    
                                </DataGrid.Columns>
                                
                            </DataGrid>

                            <TextBlock Grid.Row="1"
                                       Text="Detalle de la venta"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Margin="0,15,0,5"/>

                            <DataGrid x:Name="dgDetalleVenta"
                                      Grid.Row="2"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True">

                                <DataGrid.Columns>

                                    <DataGridTextColumn Header="Código"
                                                        Binding="{Binding Codigo}"
                                                        Width="90"/>

                                    <DataGridTextColumn Header="Producto"
                                                        Binding="{Binding Producto}"
                                                        Width="*"/>

                                    <DataGridTextColumn Header="Cantidad"
                                                        Binding="{Binding Cantidad}"
                                                        Width="80"/>

                                    <DataGridTextColumn Header="Precio"
                                                        Binding="{Binding Precio,
                                                        StringFormat={}{0:C}}"
                                                        Width="100"/>

                                    <DataGridTextColumn Header="Importe"
                                                        Binding="{Binding Importe,
                                                        StringFormat={}{0:C}}"
                                                        Width="110"/>
                                    
                                </DataGrid.Columns>
                                
                            </DataGrid>
                            
                        </Grid>
                        
                        <!-- DERECHA -->
                        <GroupBox Grid.Column="2"
                                  Header="🏆 Productos más vendidos"
                                  FontSize="16"
                                  FontWeight="Bold">

                            <DataGrid x:Name="dgMasVendidos"
                                      Margin="10"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True">

                                <DataGrid.Columns>

                                    <DataGridTextColumn Header="Producto"
                                                        Binding="{Binding Producto}"
                                                        Width="*"/>

                                    <DataGridTextColumn Header="Vendidos"
                                                        Binding="{Binding Cantidad}"
                                                        Width="75"/>

                                    <DataGridTextColumn Header="Ingresos"
                                                        Binding="{Binding Ingresos,
                                                        StringFormat={}{0:C}}"
                                                        Width="100"/>
                                    
                                </DataGrid.Columns>
                                
                            </DataGrid>
                            
                        </GroupBox>
                        
                    </Grid>

                    <TextBlock x:Name="lblResumenVentas"
                               Grid.Row="2"
                               HorizontalAlignment="Right"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="0,15,0,0"/>
                    
                </Grid>
                
            </TabItem>

            <!-- ================= COMPRAS ================= -->
            <TabItem Header="📥 Compras">

                <Grid Margin="15">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- FILTROS -->
                    <WrapPanel Margin="0,0,0,15">

                        <TextBlock Text="Desde:"
                                   VerticalAlignment="Center"/>

                        <DatePicker x:Name="dpComprasDesde"
                                    Width="140"
                                    Margin="5"/>

                        <TextBlock Text="Hasta:"
                                   VerticalAlignment="Center"
                                   Margin="15,0,0,0"/>

                        <DatePicker x:Name="dpComprasHasta"
                                    Width="140"
                                    Margin="5"/>

                        <Button Content="Buscar"
                                Width="90"
                                Margin="10,0"
                                Click="BtnBuscarCompras_Click"/>

                        <Button Content="Hoy"
                                Width="75"
                                Margin="5,0"
                                Click="BtnComprasHoy_Click"/>

                        <Button Content="Semana"
                                Width="85"
                                Margin="5,0"
                                Click="BtnComprasSemana_Click"/>

                        <Button Content="Mes"
                                Width="75"
                                Margin="5,0"
                                Click="BtnComprasMes_Click"/>

                        <Button Content="📄 Exportar Excel"
                                Width="140"
                                Margin="15,0"
                                Click="BtnExportarCompras_Click"/>

                    </WrapPanel>

                    <DataGrid x:Name="dgCompras"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionChanged="dgCompras_SelectionChanged">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Folio"
                                                Binding="{Binding Id}"
                                                Width="80"/>

                            <DataGridTextColumn Header="Fecha"
                                                Binding="{Binding Fecha,
                                                StringFormat=dd/MM/yyyy HH:mm}"
                                                Width="180"/>

                            <DataGridTextColumn Header="Productos"
                                                Binding="{Binding Productos}"
                                                Width="100"/>

                            <DataGridTextColumn Header="Total"
                                                Binding="{Binding Total,
                                                StringFormat={}{0:C}}"
                                                Width="120"/>
                            
                        </DataGrid.Columns>
                        
                    </DataGrid>

                    <TextBlock Grid.Row="2"
                               Text="Detalle de la compra"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,15,0,5"/>

                    <DataGrid x:Name="dgDetalleCompra"
                              Grid.Row="3"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Código"
                                                Binding="{Binding Codigo}"
                                                Width="100"/>

                            <DataGridTextColumn Header="Producto"
                                                Binding="{Binding Producto}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Cantidad"
                                                Binding="{Binding Cantidad}"
                                                Width="80"/>

                            <DataGridTextColumn Header="Costo"
                                                Binding="{Binding Costo,
                                                StringFormat={}{0:C}}"
                                                Width="100"/>

                            <DataGridTextColumn Header="Importe"
                                                Binding="{Binding Importe,
                                                StringFormat={}{0:C}}"
                                                Width="110"/>
                            
                        </DataGrid.Columns>
                        
                    </DataGrid>

                    <TextBlock x:Name="lblResumenCompras"
                               Grid.Row="4"
                               HorizontalAlignment="Right"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="0,15,0,0"/>
                    
                </Grid>
                
            </TabItem>
            
        </TabControl>

    </Grid>
    
</UserControl>
