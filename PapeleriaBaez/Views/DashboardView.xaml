<UserControl x:Class="PapeleriaBaez.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PapeleriaBaez.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <Grid Margin="15">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="📊 Dashboard"
                       FontSize="28"
                       FontWeight="Bold"
                       Margin="0,0,0,20"/>
            
            <!-- TARJETAS -->
            <WrapPanel Grid.Row="1">

                <Border BorderBrush="#CCCCCC"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20"
                        Width="220"
                        Margin="5">

                    <StackPanel>
                        <TextBlock Text="🛒 Ventas de hoy"
                                   FontWeight="Bold"
                                   FontSize="16"/>

                        <TextBlock x:Name="lblVentasHoy"
                                   Text="0"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                    
                </Border>

                <Border BorderBrush="#CCCCCC"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20"
                        Width="220"
                        Margin="5">

                    <StackPanel>
                        <TextBlock Text="💰 Ingresos de hoy"
                                   FontWeight="Bold"
                                   FontSize="16"/>

                        <TextBlock x:Name="lblIngresosHoy"
                                   Text="$0.00"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                    
                </Border>

                <Border BorderBrush="#CCCCCC"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20"
                        Width="220"
                        Margin="5">

                    <StackPanel>
                        <TextBlock Text="💳 Deudas pendientes"
                                   FontWeight="Bold"
                                   FontSize="16"/>

                        <TextBlock x:Name="lblDeudasPendientes"
                                   Text="$0.00"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                    
                </Border>

                <Border BorderBrush="#CCCCCC"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20"
                        Width="220"
                        Margin="5">

                    <StackPanel>
                        <TextBlock Text="⚠ Stock bajo"
                                   FontWeight="Bold"
                                   FontSize="16"/>

                        <TextBlock x:Name="lblStockBajo"
                                   Text="0"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                    
                </Border>
                
            </WrapPanel>
            
            <!-- CANJES -->
            <GroupBox Grid.Row="2"
                      Header="🎒 Canjes"
                      Margin="5,20,5,0">

                <Grid Margin="15">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Paquetes entregados"
                                   FontWeight="Bold"/>

                        <TextBlock x:Name="lblPaquetesCanje"
                                   Text="0"
                                   FontSize="24"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Conjuntos entregados"
                                   FontWeight="Bold"/>

                        <TextBlock x:Name="lblConjuntosCanje"
                                   Text="0"
                                   FontSize="24"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Tenis entregados"
                                   FontWeight="Bold"/>

                        <TextBlock x:Name="lblTenisCanje"
                                   Text="0"
                                   FontSize="24"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3">
                        <TextBlock Text="Vales pendientes"
                                   FontWeight="Bold"/>

                        <TextBlock x:Name="lblValesCanje"
                                   Text="0"
                                   FontSize="24"/>
                    </StackPanel>
                    
                </Grid>
                
            </GroupBox>
            
        </Grid>
        
    </ScrollViewer>
    
</UserControl>
