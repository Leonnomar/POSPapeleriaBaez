<UserControl x:Class="PapeleriaBaez.Views.DeudasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PapeleriaBaez.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="💳 Deudas / Fiados"
                   FontSize="28"
                   FontWeight="Bold"
                   Margin="0,0,0,15"/>

        <!-- NUEVA DEUDA -->
        <Expander Grid.Row="1"
                  Header="➕ Registrar deuda manual"
                  IsExpanded="False"
                  Margin="0,0,0,15">

            <Border BorderBrush="#CCCCCC"
                    BorderThickness="1"
                    Padding="15">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Cliente:"
                               VerticalAlignment="Center"/>

                    <TextBox x:Name="txtCliente"
                             Grid.Column="1"
                             Height="30"
                             Margin="8,0"/>

                    <TextBlock Grid.Column="2"
                               Text="Concepto:"
                               VerticalAlignment="Center"/>

                    <TextBox x:Name="txtConcepto"
                             Grid.Column="3"
                             Height="30"
                             Margin="8,0"/>

                    <TextBlock Grid.Column="4"
                               Text="Monto:"
                               VerticalAlignment="Center"/>

                    <TextBox x:Name="txtMonto"
                            Grid.Column="5"
                            Height="30"
                            Margin="8,0"/>

                    <Button Grid.Column="6"
                            Content="Registrar"
                            Width="110"
                            Margin="10.0"
                            Click="BtnRegistrarDeuda_Click"/>
                    
                </Grid>
                
            </Border>
            
        </Expander>

        <!-- CONTENIDO -->
        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- DEUDAS -->
            <GroupBox Grid.Column="0"
                      Header="Deudas">

                <Grid Margin="10">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,10">

                        <Button Content="Pendientes"
                                Width="100"
                                Margin="0,0,5,0"
                                Click="BtnPendientes_Click"/>

                        <Button Content="Pagadas"
                                Width="100"
                                Margin="5,0"
                                Click="BtnPagadas_Click"/>

                        <Button Content="Todas"
                                Width="100"
                                Margin="5,0"
                                Click="BtnTodas_Click"/>

                        <TextBlock Text="Buscar:"
                                   VerticalAlignment="Center"
                                   Margin="20,0,5,0"/>

                        <TextBox x:Name="txtBuscarDeuda"
                                 Width="220"
                                 Height="30"
                                 TextChanged="txtBuscarDeuda_TextChanged"/>

                    </StackPanel>

                    <DataGrid x:Name="dgDeudas"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionChanged="dgDeudas_SelectionChanged">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Cliente"
                                                Binding="{Binding Cliente}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Origen"
                                                Binding="{Binding Origen}"
                                                Width="100"/>

                            <DataGridTextColumn Header="Concepto"
                                                Binding="{Binding Concepto}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Fecha"
                                                Binding="{Binding Fecha,
                                                StringFormat=dd/MM/yyyy}"
                                                Width="110"/>

                            <DataGridTextColumn Header="Original"
                                                Binding="{Binding MontoOriginal,
                                                StringFormat={}{0:C}}"
                                                Width="100"/>

                            <DataGridTextColumn Header="Pendiente"
                                                Binding="{Binding SaldoPendiente,
                                                StringFormat={}{0:C}}"
                                                Width="110"/>

                            <DataGridTextColumn Header="Estado"
                                                Binding="{Binding Estado}"
                                                Width="90"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </Grid>

            </GroupBox>

            <!-- ABONOS -->
            <GroupBox Grid.Column="2"
                      Header="Abonos e historial">

                <Grid Margin="10">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="lblDeudaSeleccionada"
                               Text="Seleccione una deuda"
                               FontSize="16"
                               FontWeight="Bold"/>

                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                Margin="0,15,0,0">

                        <TextBlock Text="Abono:"
                                   VerticalAlignment="Center"/>

                        <TextBox x:Name="txtAbono"
                                 Width="110"
                                 Height="30"
                                 Margin="10,0"/>

                        <Button Content="Registrar"
                                Width="100"
                                Click="BtnRegistrarAbono_Click"/>

                    </StackPanel>

                    <TextBlock x:Name="lblSaldo"
                               Grid.Row="2"
                               Text="Saldo: $0.00"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10"/>

                    <DataGrid x:Name="dgAbonos"
                              Grid.Row="3"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Fecha"
                                                Binding="{Binding Fecha,
                                                StringFormat=dd/MM/yyyy HH:mm}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Monto"
                                                Binding="{Binding Monto,
                                                StringFormat={}{0:C}}"
                                                Width="100"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </Grid>

            </GroupBox>

        </Grid>

    </Grid>

</UserControl>